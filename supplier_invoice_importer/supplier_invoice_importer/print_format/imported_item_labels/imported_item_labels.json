 "doc_type": "Supplier Invoice Import",
 "doctype": "Print Format",
 "font": "Default",
 "html": "<style>\n@page { size: 40mm 25mm; margin: 0; }\n.print-format { width: 40mm !important; min-height: 25mm !important; margin: 0 !important; padding: 0 !important; }\n.labels { margin: 0; padding: 0; }\n.label { position: relative; box-sizing: border-box; width: 40mm; height: 25mm; margin: 0; padding: 1.2mm 1.2mm 1mm 10mm; overflow: hidden; page-break-after: always; break-after: page; color: #000; background: #fff; font-family: Arial, sans-serif; }\n.label:last-child { page-break-after: auto; break-after: auto; }\n.price-side { position: absolute; left: 0.8mm; top: 1mm; width: 8.2mm; height: 23mm; display: flex; align-items: center; justify-content: center; }\n.price-rotated { white-space: nowrap; transform: rotate(-90deg); font-weight: 800; font-size: 13pt; line-height: 1; }\n.price-caption { font-size: 6pt; font-weight: 400; margin-right: 0.7mm; }\n.item-name { height: 7.2mm; overflow: hidden; font-family: Georgia, 'Times New Roman', serif; font-size: 8.5pt; font-weight: 500; line-height: 1.08; text-align: left; }\n.company { height: 3.2mm; margin-top: 0.3mm; overflow: hidden; font-size: 7pt; font-weight: 800; line-height: 1; text-align: center; text-transform: uppercase; }\n.barcode-wrap { height: 10.3mm; text-align: center; overflow: hidden; }\n.barcode { width: 100%; height: 10.3mm; }\n</style>\n<div class=\"labels\">\n{% for row in doc.items %}\n  {% for copy in range(row.qty|int) %}\n  <div class=\"label\">\n    <div class=\"price-side\"><div class=\"price-rotated\"><span class=\"price-caption\">ціна:</span>{% if row.selling_price %}{{ (\"%.2f\"|format(row.selling_price))|replace(\".\", \",\") }} грн.{% else %}0,00 грн.{% endif %}</div></div>\n    <div class=\"item-name\">{{ row.item_name }}</div>\n    <div class=\"company\">{{ doc.company }}</div>\n    <div class=\"barcode-wrap\"><svg class=\"barcode\" jsbarcode-format=\"CODE128\" jsbarcode-value=\"{{ row.barcode or row.item_code or row.supplier_code }}\" jsbarcode-displayvalue=\"true\" jsbarcode-fontsize=\"10\" jsbarcode-textmargin=\"0\" jsbarcode-margin=\"0\"></svg></div>\n  </div>\n  {% endfor %}\n{% endfor %}\n</div>",
 "idx": 0,
 "modified": "2026-08-11 00:00:00.000000",
