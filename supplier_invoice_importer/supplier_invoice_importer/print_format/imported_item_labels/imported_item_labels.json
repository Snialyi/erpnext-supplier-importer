 "doc_type": "Supplier Invoice Import",
 "doctype": "Print Format",
 "font": "Default",
 "html": "<style>\n@page { size: 40mm 25mm; margin: 0; }\n.print-format { width: 40mm !important; margin: 0 !important; padding: 0 !important; }\n.label-page { position: relative; box-sizing: border-box; width: 40mm; height: 25mm; margin: 0; padding: 1.2mm 1.2mm 1mm 10mm; overflow: hidden; color: #000; background: #fff; font-family: Arial, sans-serif; }\n.price-side { position: absolute; left: 0.8mm; top: 1mm; width: 8.2mm; height: 23mm; display: flex; align-items: center; justify-content: center; }\n.price-rotated { white-space: nowrap; transform: rotate(-90deg); font-weight: 800; font-size: 13pt; line-height: 1; }\n.price-caption { font-size: 6pt; font-weight: 400; margin-right: 0.7mm; }\n.item-name { height: 6.6mm; overflow: hidden; font-family: Georgia, 'Times New Roman', serif; font-size: 8pt; font-weight: 500; line-height: 1.05; text-align: left; }\n.company { height: 2.7mm; overflow: hidden; font-size: 6.5pt; font-weight: 800; line-height: 1; text-align: center; text-transform: uppercase; }\n.barcode-wrap { height: 12.2mm; text-align: center; overflow: hidden; }\n.code128 { display: block; width: 100%; height: 11.5mm; }\n.page-break { display: block; page-break-after: always; break-after: page; height: 0; }\n</style>\n{% set selected_rows = (frappe.form_dict.get('selected_rows') or '').split(',') %}\n{% for row in doc.items %}\n  {% if row.name in selected_rows %}\n    {% for copy in range(row.qty|int) %}\n    <div class=\"label-page\">\n      <div class=\"price-side\"><div class=\"price-rotated\"><span class=\"price-caption\">ціна:</span>{% if row.selling_price %}{{ row.selling_price }} грн.{% else %}0,00 грн.{% endif %}</div></div>\n      <div class=\"item-name\">{{ row.item_name }}</div>\n      <div class=\"company\">{{ doc.company }}</div>\n      <div class=\"barcode-wrap\">{{ code128_svg(row.barcode or row.item_code or row.supplier_code)|safe }}</div>\n    </div>\n    <div class=\"page-break\"></div>\n    {% endfor %}\n  {% endif %}\n{% endfor %}",
 "idx": 0,
