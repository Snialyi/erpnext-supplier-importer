{
 "align_labels_right": 0,
 "creation": "2026-08-11 00:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Supplier Invoice Import",
 "doctype": "Print Format",
 "font": "Default",
 "html": "<style>\n@page { size: A4; margin: 8mm; }\n.print-format { padding: 0 !important; }\n.labels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3mm; }\n.label { height: 34mm; border: 1px dashed #bbb; padding: 2.5mm; text-align: center; overflow: hidden; page-break-inside: avoid; }\n.item-name { height: 9mm; overflow: hidden; font-size: 9pt; font-weight: 600; line-height: 1.15; }\n.barcode { width: 100%; height: 14mm; }\n.code { font-size: 8pt; letter-spacing: .3px; }\n.price { font-size: 12pt; font-weight: 700; margin-top: 1mm; }\n</style>\n<div class=\"labels\">\n{% for row in doc.items %}\n  {% for copy in range(row.qty|int) %}\n  <div class=\"label\">\n    <div class=\"item-name\">{{ row.item_name }}</div>\n    <svg class=\"barcode\" jsbarcode-format=\"CODE128\" jsbarcode-value=\"{{ row.barcode or row.item_code or row.supplier_code }}\" jsbarcode-displayvalue=\"false\"></svg>\n    <div class=\"code\">{{ row.barcode or row.item_code or row.supplier_code }}</div>\n    {% if row.selling_price %}<div class=\"price\">{{ frappe.utils.fmt_money(row.selling_price, currency=doc.selling_price_currency) }}</div>{% endif %}\n  </div>\n  {% endfor %}\n{% endfor %}\n</div>",
 "idx": 0,
 "modified": "2026-08-11 00:00:00.000000",
 "modified_by": "Administrator",
 "module": "Supplier Invoice Importer",
 "name": "Imported Item Labels",
 "owner": "Administrator",
 "print_format_builder": 0,
 "print_format_type": "Jinja",
 "raw_printing": 0,
 "show_section_headings": 0,
 "standard": "Yes"
}
